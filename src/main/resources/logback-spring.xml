<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="HOSTNAME" value="${HOSTNAME:-unknown}"/>
    <property name="LOG_PATH" value="/var/log/dte"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS}|%level|%class|%method|%X{requestId}|%X{traceId}|%X{username}|%X{planId}|%m%n"/>

    <!-- Console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Remove the static <file> tag — let the policy manage the filename -->
        <!-- This is the key fix: static <file> prevents time-based rollover -->

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${HOSTNAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>

    <!-- Suppress Kafka internal noise -->
    <logger name="org.apache.kafka.clients.producer.ProducerConfig"                level="WARN"/>
    <logger name="org.apache.kafka.clients.producer.KafkaProducer"                 level="WARN"/>
    <logger name="org.apache.kafka.common.utils.AppInfoParser"                     level="WARN"/>
    <logger name="org.apache.kafka.clients.Metadata"                               level="WARN"/>
    <logger name="org.apache.kafka.clients.producer.internals.TransactionManager"  level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>