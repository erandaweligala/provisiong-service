    {
      "id": 11,
      "type": "timeseries",
      "title": "Response status mix",
      "description": "All catalogued traffic split by HTTP status. 4xx counts as available - it is the endpoint rejecting a bad request - so watch it here rather than in the availability figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", api!=\"other\"}[$__rate_interval]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
