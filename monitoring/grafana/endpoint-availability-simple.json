{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Minimal version of the endpoint availability dashboard: just 'is it up'. One overall number plus one line per endpoint. For error rate, latency and the synthetic probe, use user-provisioning-endpoint-availability.json instead.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (all endpoints)",
      "description": "Share of requests in the selected window that did not answer 5xx. 4xx counts as available - a rejected bad request means the endpoint is working.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 3,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api!=\"other\", status!~\"5..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api!=\"other\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api!=\"other\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods reporting metrics",
      "description": "0 means nothing is being scraped - check the ServiceMonitor and /actuator/prometheus before trusting the availability number.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(count by (instance) (api_endpoint_threshold_milliseconds{microservice=~\"$microservice\", api!=\"other\"}))",
          "refId": "A",
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Availability by endpoint",
      "description": "Same calculation as the big number, broken down per endpoint. An endpoint with no line took no traffic in this window - that is not the same as being healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 2,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "min",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * ((sum by (api) (rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api!=\"other\", status!~\"5..\"}[$__rate_interval])) or sum by (api) (rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api!=\"other\"}[$__rate_interval])) * 0) / sum by (api) (rate(http_server_requests_seconds_count{microservice=~\"$microservice\", api!=\"other\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{api}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "airtel-aaa",
    "availability",
    "user-provisioning",
    "simple"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(api_endpoint_threshold_milliseconds, microservice)",
        "hide": 0,
        "includeAll": false,
        "label": "Microservice",
        "multi": false,
        "name": "microservice",
        "options": [],
        "query": {
          "query": "label_values(api_endpoint_threshold_milliseconds, microservice)",
          "refId": "microservice"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "AAA User Provisioning - Endpoint availability (simple)",
  "uid": "aaa-user-prov-endpoints-simple",
  "version": 1,
