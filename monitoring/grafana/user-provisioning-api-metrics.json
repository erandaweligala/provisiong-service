{
  "uid": "aaa-user-prov-api-metrics",
  "title": "AAA User Provisioning - API success, failure and response time",
  "description": "Success count, failure count and average response time for every REST API of airtel-aaa-user-provisioning-service, from the http_server_requests timer Spring Boot already publishes, grouped by the `api` tag the endpoint catalog adds. Counts are over the dashboard's time range. See monitoring/API-METRICS.md.",
  "tags": [
    "aaa",
    "user-provisioning",
    "api",
    "traffic"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "timezone": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Related dashboards",
      "type": "dashboards",
      "tags": [
        "user-provisioning"
      ],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "microservice",
        "label": "Microservice",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "query": {
          "qryType": 1,
          "query": "label_values(api_endpoint_info, microservice)",
          "refId": "A"
        },
        "definition": "label_values(api_endpoint_info, microservice)",
        "current": {},
        "options": [],
        "sort": 1
      },
      {
        "name": "api",
        "label": "API",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "query": {
          "qryType": 1,
          "query": "label_values(api_endpoint_info{microservice=~\"$microservice\"}, api)",
          "refId": "A"
        },
        "definition": "label_values(api_endpoint_info{microservice=~\"$microservice\"}, api)",
        "current": {},
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Totals over the selected time range",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests",
      "description": "Every request the selected APIs served in the dashboard's time range. Success + Failed, and the denominator of the failure rate beside it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\"}[$__range])) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Successful",
      "description": "Requests that answered below 400 - Micrometer outcome INFORMATIONAL, SUCCESS or REDIRECTION. Counted over the dashboard's time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome!~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range])) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed",
      "description": "Requests that answered 4xx or 5xx - Micrometer outcome CLIENT_ERROR or SERVER_ERROR. Counted over the dashboard's time range. The per-API table splits this into client and server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range])) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failure rate",
      "description": "Failed as a share of all requests. Blank when nothing was called - a service with no traffic has no failure rate, and reading it as 0% would hide an outage upstream. Amber and red are the same 1% / 10% thresholds the endpoint health verdict uses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "100 * (sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range]))) / (sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\"}[$__range])))",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "unit": "percent",
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Average response time",
      "description": "Total time spent serving the selected APIs divided by the number of requests, over the dashboard's time range. Exact, not a percentile estimate - it is the timer's own sum over its own count. A handful of very slow calls barely move it, so read it beside the per-API chart below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_sum{microservice=~\"$microservice\", api=~\"$api\"}[$__range])) / sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\"}[$__range]))",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "unit": "s",
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Uncatalogued",
      "description": "Requests tagged api=\"other\" - traffic to a path that is not in monitoring.api.endpoints. It is deliberately not broken down (that is what keeps the api label's cardinality bounded), and it ignores the Endpoint picker. Anything but a trickle here means the catalog is missing an entry.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=\"other\"}[$__range])) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Per API",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Success, failure and response time by API",
      "description": "One row per API in the catalog, counted over the dashboard's time range. Success is every response below 400, Failed is every 4xx and 5xx, and Avg response time is that API's total serving time over its own request count. Sorted by Failed so a broken API comes to the top. An API nobody called reads 0 / 0 and leaves the timing columns blank - it has no response time to average. The amber and red cues on Avg response time are display thresholds only (1s / 3s), not per-API budgets; nothing alerts on them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (api, title) (api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome!~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "sum by (api) (increase(http_server_requests_seconds_sum{microservice=~\"$microservice\", api=~\"$api\"}[$__range])) / sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\"}[$__range]))",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "100 * (sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})) / sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\"}[$__range]))",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=\"CLIENT_ERROR\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=\"SERVER_ERROR\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(api|title|Value.*)$"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "api",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true
            },
            "indexByName": {
              "title": 0,
              "Value #B": 1,
              "Value #C": 2,
              "Value #D": 3,
              "Value #E": 4,
              "Value #F": 5,
              "Value #G": 6,
              "Value #H": 7,
              "api": 8,
              "Value #A": 9
            },
            "renameByName": {
              "title": "API",
              "Value #B": "Success",
              "Value #C": "Failed",
              "Value #D": "Avg response time",
              "Value #E": "Failure %",
              "Value #F": "Total",
              "Value #G": "Client errors (4xx)",
              "Value #H": "Server errors (5xx)",
              "api": "Metric tag"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Failed",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Success"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg response time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failure %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Client errors (4xx)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
