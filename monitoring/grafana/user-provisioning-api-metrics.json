          },
          "refId": "C",
          "expr": "sum by (api) (increase(http_server_requests_seconds_count{microservice=~\"$microservice\", api=~\"$api\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__range])) or sum by (api) (0 * api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
