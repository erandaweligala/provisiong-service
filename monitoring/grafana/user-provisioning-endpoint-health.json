    {
      "id": 17,
      "type": "table",
      "title": "Endpoints blocked by a dependency outage",
      "description": "Joins the dependencies each endpoint declares against dependency_up from connectivity monitoring: every row is an endpoint that cannot serve because something it needs is unreachable. Empty is the healthy state. This is the panel that explains a wall of red without opening the connectivity dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 52
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (api, dependency) (api_endpoint_dependency_required{microservice=~\"$microservice\", api=~\"$api\"})\n  and on (dependency)\n(max by (dependency) (dependency_up{microservice=~\"$microservice\"}) == 0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
