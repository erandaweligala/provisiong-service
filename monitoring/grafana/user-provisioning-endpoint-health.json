{
  "uid": "aaa-user-prov-endpoint-health",
  "title": "AAA User Provisioning - REST endpoint health",
  "description": "Health of each REST endpoint of airtel-aaa-user-provisioning-service, individually. Health is not availability: availability is the share of requests that did not fail, so an endpoint nobody called reads 100% either way. Health is decided every 15s from three checks - the handler is mapped in this build, every dependency the endpoint declares is reachable, and the 5xx ratio is under the configured thresholds - so an idle endpoint still gets a real answer. See monitoring/HEALTH.md.",
  "tags": [
    "aaa",
    "user-provisioning",
    "health",
    "endpoints"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "timezone": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Related dashboards",
      "type": "dashboards",
      "tags": [
        "user-provisioning"
      ],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "microservice",
        "label": "Microservice",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "query": {
          "qryType": 1,
          "query": "label_values(api_endpoint_health, microservice)",
          "refId": "A"
        },
        "definition": "label_values(api_endpoint_health, microservice)",
        "current": {},
        "options": [],
        "sort": 1
      },
      {
        "name": "api",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "query": {
          "qryType": 1,
          "query": "label_values(api_endpoint_health{microservice=~\"$microservice\"}, api)",
          "refId": "A"
        },
        "definition": "label_values(api_endpoint_health{microservice=~\"$microservice\"}, api)",
        "current": {},
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unhealthy endpoints",
      "description": "Endpoints whose handler is missing, whose required dependency is down, or that are failing above monitoring.api.health.unhealthy-error-ratio. Anything above zero here is a page.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(min by (api) (api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"}) == 1) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Degraded endpoints",
      "description": "Endpoints serving with errors above monitoring.api.health.degraded-error-ratio, or with a failure seen under the request floor where a ratio would not be meaningful. Worth looking at, not worth waking for.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(min by (api) (api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"}) == 2) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Healthy endpoints",
      "description": "Endpoints serving cleanly, or idle with every dependency they declare reachable and their handler mapped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(min by (api) (api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"}) == 3) or vector(0)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Worst endpoint",
      "description": "The state of the least healthy endpoint - the single number to put on a wall board. Reads Unknown before the first evaluation completes, roughly 15 seconds after a pod starts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min(api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "text",
                  "index": 3
                },
                "1": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 0
                },
                "2": {
                  "text": "Degraded",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Health per endpoint",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Health by endpoint",
      "description": "Every catalogued endpoint, one tile each, coloured by its current state. Tiles appear from startup - an endpoint does not have to be called to be shown - so a missing tile means the catalog itself is not being scraped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min by (api, title) (api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{title}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "text",
                  "index": 3
                },
                "1": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 0
                },
                "2": {
                  "text": "Degraded",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Health over time",
      "description": "The same states as a history. Read a red band left to right: where it starts is when the endpoint broke, and the reason panel below says what broke. Bands are drawn from the 15-second evaluation, so a state shorter than that may not appear.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min by (api, title) (api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{title}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "text",
                  "index": 3
                },
                "1": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 0
                },
                "2": {
                  "text": "Degraded",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "min": 0,
          "max": 3
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Endpoint health detail",
      "description": "Everything behind the verdict, one row per endpoint. Reason is which of the three checks decided the state: not_mapped (no handler here), dependency_down (a declared dependency is unreachable), errors (5xx over the window), ok (traffic, none failed), idle (no traffic, nothing else wrong). Requests and 5xx are counts over the health window, not rates.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (api, title) (api_endpoint_info{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "min by (api) (api_endpoint_health{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "max by (api, reason) (api_endpoint_health_reason{microservice=~\"$microservice\", api=~\"$api\"} == 1)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "min by (api) (api_endpoint_mapped{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "sum by (api) (api_endpoint_requests_window{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "sum by (api) (api_endpoint_errors_window{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "100 * max by (api) (api_endpoint_error_ratio{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "max by (api) (api_endpoint_unhealthy_seconds{microservice=~\"$microservice\", api=~\"$api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "I",
          "expr": "max by (api) (api_endpoint_last_failure_timestamp_seconds{microservice=~\"$microservice\", api=~\"$api\"}) * 1000 > 0",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(api|title|reason|Value.*)$"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "api",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true
            },
            "indexByName": {
              "title": 0,
              "api": 1,
              "Value #B": 2,
              "reason": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #A": 10
            },
            "renameByName": {
              "title": "Endpoint",
              "api": "Metric tag",
              "Value #B": "Health",
              "reason": "Reason",
              "Value #D": "Mapped",
              "Value #E": "Requests",
              "Value #F": "5xx",
              "Value #G": "5xx share",
              "Value #H": "Unhealthy for",
              "Value #I": "Last 5xx"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Health",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unknown",
                        "color": "text",
                        "index": 3
                      },
                      "1": {
                        "text": "Unhealthy",
                        "color": "red",
                        "index": 0
                      },
                      "2": {
                        "text": "Degraded",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "Healthy",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "green",
                      "value": 3
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mapped"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "yes",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unhealthy for"
            },
            "properties": [
